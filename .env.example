# Enterprise Agentic RAG Engine - Environment Configuration

# Server
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=enterprise_knowledge_base
VECTOR_DIMENSION=384

# Embeddings & Reranking
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Hybrid Search Parameters
BM25_K1=1.5
BM25_B=0.75
HYBRID_RRF_K=60
TOP_K_RETRIEVAL=10
RERANK_TOP_N=4

# LLM Inference Server (vLLM / HuggingFace)
LLM_PROVIDER=vllm
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL_NAME=meta-llama/Meta-Llama-3-8B-Instruct-AWQ
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Agent Thresholds
MAX_AGENT_HOPS=3
RELEVANCE_THRESHOLD=0.65
FAITHFULNESS_THRESHOLD=0.85
